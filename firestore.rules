rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Phase 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Phase 3: Reusable hardened primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Pillar 2: Validation Blueprints matching firebase-blueprint.json verbatim
    function isValidUserProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'lastActiveEditionId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('lastActiveEditionId' in data) || isValidId(data.lastActiveEditionId))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStudyEdition(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'isPublic',
          'revision',
          'topicOverrides',
          'questionOverrides',
          'addedQuestions',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'bio',
          'isPublic',
          'revision',
          'topicOverrides',
          'questionOverrides',
          'addedQuestions',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 200))
        && data.isPublic is bool
        && data.revision is int
        && data.revision >= 0
        && data.revision <= 1000000
        && data.topicOverrides is map
        && data.topicOverrides.size() <= 50
        && data.questionOverrides is map
        && data.questionOverrides.size() <= 100
        && data.addedQuestions is list
        && data.addedQuestions.size() <= 100
        && (data.addedQuestions.size() == 0 || data.addedQuestions[0] is map)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Private User Profiles (PII-isolated, strictly owner-only, no list)
    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'lastActiveEditionId', 'updatedAt']);
      allow delete: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid);
    }

    // User Study Editions (Owner full access; public editions readable/listable by learners)
    match /editions/{uid} {
      allow get: if isValidId(uid)
        && (existing().isPublic == true || isOwner(uid));
      allow list: if existing().isPublic == true
        || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidStudyEdition(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid)
        && isValidStudyEdition(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().revision >= existing().revision
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'bio',
            'isPublic',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'bio',
            'isPublic',
            'revision',
            'topicOverrides',
            'questionOverrides',
            'addedQuestions',
            'updatedAt'
          ])
        );
      allow delete: if isVerifiedUser()
        && isValidId(uid)
        && isOwner(uid);
    }
  }
}
